<Ui xmlns="http://www.blizzard.com/wow/ui/"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.blizzard.com/wow/ui/ C:\Projects\WoW\Bin\Interface\FrameXML\UI.xsd">

  <!-- Script -->
  <Script file="DataToText.lua"/>

  <!-- Main Frame -->
  <Frame name="DataToTextFrame" toplevel="true" frameStrata="DIALOG" movable="true" enableMouse="true" hidden="true" parent="UIParent">
    <TitleRegion setAllPoints="true"/>
    <Size>
      <AbsDimension x="800" y="400"/>
    </Size>
    <Anchors>
      <Anchor point="CENTER" relativeTo="UIParent" />
    </Anchors>
    <Backdrop edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="false">
      <EdgeSize>
        <AbsValue val="16"/>
      </EdgeSize>
      <BackgroundInsets>
        <AbsInset left="4" right="4" top="4" bottom="4"/>
      </BackgroundInsets>
      <Color r="0" g="0" b="0" a="1"/>
    </Backdrop>

    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="DataToText_background">
          <Anchors>
            <Anchor point="TOPLEFT">
              <Offset>
                <AbsDimension x="4" y="-4"/>
              </Offset>
            </Anchor>
            <Anchor point="BOTTOMRIGHT">
              <Offset>
                <AbsDimension x="-4" y="4"/>
              </Offset>
            </Anchor>
          </Anchors>
          <Color r="0" g="0" b="0" a="1"/>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <FontString name="DataToText_Title" inherits="GameFontNormal" text="DataToText - OCR Data Display">
          <Anchors>
            <Anchor point="TOP">
              <Offset>
                <AbsDimension x="0" y="-10"/>
              </Offset>
            </Anchor>
          </Anchors>
          <Color r="1" g="1" b="1"/>
        </FontString>

        <!-- Player Info -->
        <FontString name="DataToText_PlayerInfo" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT">
              <Offset>
                <AbsDimension x="15" y="-35"/>
              </Offset>
            </Anchor>
          </Anchors>
          <FontHeight>
            <AbsValue val="12"/>
          </FontHeight>
          <Color r="1" g="1" b="1"/>
        </FontString>

        <!-- Target Info -->
        <FontString name="DataToText_TargetInfo" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="DataToText_PlayerInfo" relativePoint="BOTTOMLEFT">
              <Offset>
                <AbsDimension x="0" y="-10"/>
              </Offset>
            </Anchor>
          </Anchors>
          <FontHeight>
            <AbsValue val="12"/>
          </FontHeight>
          <Color r="1" g="1" b="1"/>
        </FontString>

        <!-- Bag Info -->
        <FontString name="DataToText_BagInfo" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="DataToText_TargetInfo" relativePoint="BOTTOMLEFT">
              <Offset>
                <AbsDimension x="0" y="-10"/>
              </Offset>
            </Anchor>
          </Anchors>
          <FontHeight>
            <AbsValue val="12"/>
          </FontHeight>
          <Color r="1" g="1" b="1"/>
        </FontString>
      </Layer>
    </Layers>

    <Frames>
      <Button name="DataToText_buttonClose" parent="DataToTextFrame" inherits="GameMenuButtonTemplate" text="Close">
        <Size>
          <AbsDimension x="100" y="24"/>
        </Size>
        <Anchors>
          <Anchor point="BOTTOMRIGHT">
            <Offset>
              <AbsDimension x="-15" y="15"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            DataToText_UI_OnClick(this);
          </OnClick>
        </Scripts>
      </Button>
    </Frames>

    <Scripts>
      <OnLoad>
        DataToText_OnLoad();
      </OnLoad>
      <OnEvent>
        DataToText_OnEvent(event);
      </OnEvent>
      <OnUpdate>
        DataToText_OnUpdate(arg1);
      </OnUpdate>
    </Scripts>
  </Frame>

  <GameTooltip name="DataToTextTooltip" frameStrata="TOOLTIP" hidden="true" parent="DataToTextFrame" inherits="GameTooltipTemplate" />
</Ui>
