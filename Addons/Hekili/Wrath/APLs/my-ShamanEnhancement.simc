## Shaman: Enhancement - 增强萨练级版
## ========================================
## 单体: 烈焰震击(DOT保持) > 大地震击 > 火焰新星
## 多目标: 灼热图腾 > 火焰新星
## ========================================
## 武器附魔: 火舌武器
## ========================================

## 战前准备动作
## 主手无附魔时，使用火舌武器附魔
actions.precombat+=/flametongue_weapon,if=!mainhand_imbued
## 副手无附魔时，使用火舌武器附魔
actions.precombat+=/flametongue_weapon,if=!offhand_imbued
## 没有护盾时，施放水之盾
actions.precombat+=/water_shield,if=buff.shield.down

## ========================================
## 主动作分流：根据目标数量选择单体或AOE循环
## ========================================
## 护盾消失时补充水之盾
actions+=/water_shield,if=buff.shield.down
## 多目标时使用AOE循环
actions+=/run_action_list,name=aoe,if=active_enemies>1
## 单目标循环
actions+=/run_action_list,name=single,if=!has_any_totem | active_enemies<2 
## 副本中：远离图腾就回收
actions+=/totemic_recall,if=has_any_totem&player_far_from_totem&state.instanceType!="none"
## 野外：远离图腾且脱战才回收
actions+=/totemic_recall,if=has_any_totem&player_far_from_totem&combat=0
## 主手无附魔时，使用火舌武器附魔
actions+=/flametongue_weapon,if=!mainhand_imbued
## 副手无附魔时，使用火舌武器附魔
actions+=/flametongue_weapon,if=!offhand_imbued

## ========================================
## 单目标循环
## 【省蓝逻辑】根据目标绝对血量选择技能，避免过度击杀浪费法力
## ========================================
## 目标无烈焰震击DOT且存活时间>5秒时施放
actions.single+=/flame_shock,if=!ticking&target.health.current>200&target.time_to_die>5
## 目标生命值>200时使用大地震击
actions.single+=/earth_shock,if=target.health.current>200
## 目标生命值>200时使用火焰新星
actions.single+=/fire_nova,if=target.health.current > 300 & mana.pct > 40

## ========================================
## 多目标AOE循环
## ========================================
## 灼热图腾未激活时召唤
## actions.aoe+=/searing_totem,if=!totem.searing_totem.active
## 火焰新星AOE伤害, 有火焰图腾时使用
actions.aoe+=/fire_nova,if=buff.fire_totem.up
