<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VizAura.App"
             xmlns:local="using:VizAura"
             xmlns:converters="using:VizAura.Converters"
             RequestedThemeVariant="Light">
             <!-- 强制使用浅色主题以确保字体对比度 -->

    <Application.Resources>
        <converters:StatusIconConverter x:Key="StatusIconConverter"/>
        <converters:EnumEqualityConverter x:Key="EnumEqualityConverter"/>
        <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter"/>
        <converters:StatusBorderBrushConverter x:Key="StatusBorderBrushConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>