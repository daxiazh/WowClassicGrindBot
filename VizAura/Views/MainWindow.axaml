<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VizAura.ViewModels"
        xmlns:views="using:VizAura.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VizAura.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VizAura"
        Width="700"
        Height="500">

    <!-- 使用 ContentControl 根据 CurrentViewModel 自动切换视图 -->
    <ContentControl Content="{Binding CurrentViewModel}">
        <ContentControl.DataTemplates>
            <!-- ValidationViewModel 对应 ValidationPanel -->
            <DataTemplate DataType="vm:ValidationViewModel">
                <views:ValidationPanel/>
            </DataTemplate>
            
            <!-- WorkViewModel 对应 WorkPanel -->
            <DataTemplate DataType="vm:WorkViewModel">
                <views:WorkPanel/>
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>

</Window>
