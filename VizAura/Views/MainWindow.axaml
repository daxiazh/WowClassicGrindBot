<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VizAura.ViewModels"
        xmlns:views="using:VizAura.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VizAura.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VizAura"
        Width="700"
        Height="600">

    <DockPanel>
        <!-- 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="配置">
                <MenuItem Header="🔄 重新验证环境" Command="{Binding RevalidateCommand}"/>
                <MenuItem Header="🗑️ 清除所有配置" Command="{Binding ResetAllConfigCommand}"/>
                <Separator/>
                <MenuItem Header="📦 AddOns 管理" Command="{Binding ShowAddonsConfigCommand}" IsEnabled="{Binding CanConfigureAddons}"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于 VizAura"/>
            </MenuItem>
        </Menu>

        <!-- 底部日志区域 -->
        <Border DockPanel.Dock="Bottom"
                Background="#1E1E1E"
                BorderBrush="#3C3C3C"
                BorderThickness="0,1,0,0"
                Height="200">
            <Grid RowDefinitions="Auto,*">
                <!-- 日志标题栏 -->
                <Border Grid.Row="0"
                        Background="#2D2D30"
                        Padding="10,5">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="📋 日志输出"
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="2"
                                Content="📋 复制所有日志"
                                Command="{Binding CopyAllLogsCommand}"
                                Margin="0,0,10,0"
                                Padding="8,4"
                                Background="#3C3C3C"
                                Foreground="#CCCCCC"
                                BorderBrush="#555555"
                                VerticalAlignment="Center"/>
                        
                        <CheckBox Grid.Column="3"
                                  Content="自动滚动"
                                  IsChecked="{Binding AutoScrollLog}"
                                  Foreground="#CCCCCC"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 日志内容 -->
                <ListBox Grid.Row="1"
                         Name="LogListBox"
                         ItemsSource="{Binding LogMessages}"
                         Background="#1E1E1E"
                         BorderThickness="0"
                         SelectionMode="Multiple">
                    <ListBox.Styles>
                        <!-- 移除选中高亮背景 -->
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#264F78"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#2A2D2E"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding}"
                                                 FontFamily="Consolas,Menlo,monospace"
                                                 FontSize="11"
                                                 Foreground="#D4D4D4"
                                                 Padding="5,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 主内容区域 - 使用 ContentControl 根据 CurrentViewModel 自动切换视图 -->
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.DataTemplates>
                <!-- ValidationViewModel 对应 ValidationPanel -->
                <DataTemplate DataType="vm:ValidationViewModel">
                    <views:ValidationPanel/>
                </DataTemplate>
                
                <!-- WorkViewModel 对应 WorkPanel -->
                <DataTemplate DataType="vm:WorkViewModel">
                    <views:WorkPanel/>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>

</Window>
