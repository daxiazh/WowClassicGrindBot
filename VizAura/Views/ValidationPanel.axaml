<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VizAura.ViewModels"
             xmlns:views="using:VizAura.Views"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="VizAura.Views.ValidationPanel"
             x:DataType="vm:ValidationViewModel">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VizAura 环境检查"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="正在验证运行环境..."
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       IsVisible="{Binding IsValidating}"/>
        </StackPanel>

        <!-- 验证步骤列表 -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.DataTemplates>
                    <!-- WoW 进程步骤 -->
                    <DataTemplate DataType="vm:WowProcessStepViewModel">
                        <views:WowProcessStepView/>
                    </DataTemplate>

                    <!-- 插件步骤 -->
                    <DataTemplate DataType="vm:AddonStepViewModel">
                        <views:AddonStepView/>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
