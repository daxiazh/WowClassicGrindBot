<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VizAura.ViewModels"
             xmlns:views="using:VizAura.Views"
             xmlns:controls="https://atomui.net"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="VizAura.Views.ValidationPanel"
             x:DataType="vm:ValidationViewModel">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VizAura 环境检查"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="正在验证运行环境..."
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       IsVisible="{Binding IsValidating}"/>
        </StackPanel>

        <!-- AtomUI Steps 步骤条 + 内容区域 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 步骤指示器 -->
            <controls:Steps Grid.Row="0" 
                            CurrentStep="{Binding CurrentStepIndex}" 
                            Margin="0,0,0,20">
                <controls:StepsItem Header="检查 WoW 进程" 
                                    Description="查找 World of Warcraft 进程"/>
                <controls:StepsItem Header="检查 DataToColor 插件" 
                                    Description="验证插件安装"/>
                <controls:StepsItem Header="检查 Frame 配置" 
                                    Description="验证数据帧配置"/>
            </controls:Steps>

            <!-- 当前步骤的详细内容 -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="20">
                    <!-- 步骤内容 -->
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="20"
                                        Margin="0,0,0,10"
                                        IsVisible="{Binding IsExpanded}">
                                    <StackPanel Spacing="10">
                                        <!-- 步骤标题 -->
                                        <TextBlock Text="{Binding StepName}"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                        
                                        <!-- 步骤内容视图 -->
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.DataTemplates>
                                                <DataTemplate DataType="vm:WowProcessStepViewModel">
                                                    <views:WowProcessStepView/>
                                                </DataTemplate>
                                                <DataTemplate DataType="vm:AddonStepViewModel">
                                                    <views:AddonStepView/>
                                                </DataTemplate>
                                                <DataTemplate DataType="vm:FrameStepViewModel">
                                                    <views:FrameStepView/>
                                                </DataTemplate>
                                            </ContentControl.DataTemplates>
                                        </ContentControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
