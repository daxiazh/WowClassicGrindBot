<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VizAura.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="VizAura.Views.WorkPanel"
             x:DataType="vm:WorkViewModel">

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- 标题栏 -->
            <Border Background="#2196F3"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel Spacing="5">
                    <TextBlock Text="VizAura - DataToColor 实时监控"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#E3F2FD"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Addon 数据读取警告 -->
            <Border Background="#FF5722"
                    CornerRadius="8"
                    Padding="15"
                    IsVisible="{Binding ShowAddonWarning}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚠️"
                                   FontSize="18"
                                   VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding AddonWarningMessage}"
                                   FontSize="13"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <TextBlock FontSize="12"
                                   Foreground="#FFCCBC">
                            <Run Text="失败次数: "/>
                            <Run Text="{Binding AddonReadFailureCount}"
                                 FontWeight="Bold"/>
                        </TextBlock>
                        
                        <!-- 重新配置 Frame 按钮 (仅在分辨率改变时显示) -->
                        <Button Content="🔧 重新配置 Frame"
                                Command="{Binding ReconfigureFrameCommand}"
                                Background="#D32F2F"
                                Foreground="White"
                                Padding="10,5"
                                CornerRadius="4"
                                IsVisible="{Binding AddonWarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 数据显示区域 -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">
                <!-- 玩家生命值 -->
                <Border Grid.Row="0" Grid.Column="0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,5,5">
                    <StackPanel Spacing="8">
                        <TextBlock Text="❤️ 玩家生命值"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <ProgressBar Value="{Binding PlayerHealthCurrent}"
                                     Maximum="{Binding PlayerHealthMax}"
                                     Height="20"
                                     Foreground="#F44336"/>
                        <TextBlock FontSize="12"
                                   Foreground="#666">
                            <Run Text="{Binding PlayerHealthCurrent}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding PlayerHealthMax}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 玩家法力值 -->
                <Border Grid.Row="0" Grid.Column="1"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="5,0,0,5">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💙 玩家法力值"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <ProgressBar Value="{Binding PlayerManaCurrent}"
                                     Maximum="{Binding PlayerManaMax}"
                                     Height="20"
                                     Foreground="#2196F3"/>
                        <TextBlock FontSize="12"
                                   Foreground="#666">
                            <Run Text="{Binding PlayerManaCurrent}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding PlayerManaMax}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 目标生命值 -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,5,0,5">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🎯 目标生命值"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <ProgressBar Value="{Binding TargetHealthCurrent}"
                                     Maximum="{Binding TargetHealthMax}"
                                     Height="20"
                                     Foreground="#FF9800"/>
                        <TextBlock FontSize="12"
                                   Foreground="#666">
                            <Run Text="{Binding TargetHealthCurrent}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TargetHealthMax}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 调试信息 -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="#F5F5F5"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,5,0,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="📊 调试信息"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock FontSize="11"
                                   Foreground="#666"
                                   FontFamily="Consolas,Menlo,monospace">
                            <Run Text="GlobalTime: "/>
                            <Run Text="{Binding GlobalTime}"/>
                            <Run Text="  |  Frames: "/>
                            <Run Text="{Binding WelcomeMessage}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
