<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VizAura.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="VizAura.Views.WorkPanel"
             x:DataType="vm:WorkViewModel">

    <Grid Margin="20">
        <StackPanel Spacing="15">
            <!-- 标题栏 -->
            <Border Background="#2196F3"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel Spacing="5">
                    <TextBlock Text="VizAura - DataToColor 实时监控"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#E3F2FD"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Addon 数据读取警告 -->
            <Border Background="#FF5722"
                    CornerRadius="8"
                    Padding="15"
                    IsVisible="{Binding ShowAddonWarning}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚠️"
                                   FontSize="18"
                                   VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding AddonWarningMessage}"
                                   FontSize="13"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock FontSize="12"
                               Foreground="#FFCCBC">
                        <Run Text="失败次数: "/>
                        <Run Text="{Binding AddonReadFailureCount}"
                             FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Hekili 技能推荐区域 (仅自动模式) -->
            <Border Background="#1E1E1E"
                    BorderBrush="#4CAF50"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="15"
                    IsVisible="{Binding IsHekiliAutoMode}">
                <StackPanel Spacing="10">
                    <TextBlock Text="⚔️ Hekili 技能推荐 (自动模式)"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#4CAF50"
                               HorizontalAlignment="Center"/>
                    
                    <!-- 技能 1 -->
                    <Border Background="#2A2A2A"
                            BorderBrush="#2196F3"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Cursor="Hand"
                            PointerPressed="OnSpell1Click">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="1️⃣"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Spell1Name}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#2196F3"/>
                                <TextBlock FontSize="13"
                                           Foreground="#9E9E9E">
                                    <Run Text="CD: "/>
                                    <Run Text="{Binding Spell1CooldownSec, StringFormat={}{0:F1}}"
                                         Foreground="#FF9800"/>
                                    <Run Text=" 秒"/>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="#424242"
                                    BorderBrush="#FFC107"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    IsVisible="{Binding Spell1Keybind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Spell1Keybind}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#FFC107"
                                           FontFamily="Consolas,Menlo,monospace"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- 技能 2 -->
                    <Border Background="#2A2A2A"
                            BorderBrush="#2196F3"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Cursor="Hand"
                            PointerPressed="OnSpell2Click">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="2️⃣"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Spell2Name}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#2196F3"/>
                                <TextBlock FontSize="13"
                                           Foreground="#9E9E9E">
                                    <Run Text="CD: "/>
                                    <Run Text="{Binding Spell2CooldownSec, StringFormat={}{0:F1}}"
                                         Foreground="#FF9800"/>
                                    <Run Text=" 秒"/>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="#424242"
                                    BorderBrush="#FFC107"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    IsVisible="{Binding Spell2Keybind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Spell2Keybind}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#FFC107"
                                           FontFamily="Consolas,Menlo,monospace"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Hekili 未启用或非自动模式警告 -->
            <Border Background="#424242"
                    BorderBrush="#757575"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="15"
                    IsVisible="{Binding !IsHekiliAutoMode}">
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ Hekili 自动模式未启用"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFC107"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="请在 Hekili 中切换到「自动模式」以查看技能推荐"
                               FontSize="12"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 紧凑的玩家状态栏 -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                <!-- 玩家生命值 -->
                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,5,0">
                    <TextBlock Text="❤️ 生命值"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding PlayerHealthCurrent}"
                                 Maximum="{Binding PlayerHealthMax}"
                                 Height="10"
                                 Foreground="#F44336"/>
                    <TextBlock FontSize="10"
                               Foreground="#666">
                        <Run Text="{Binding PlayerHealthCurrent}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding PlayerHealthMax}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 玩家法力值 -->
                <StackPanel Grid.Column="1" Spacing="3" Margin="5,0">
                    <TextBlock Text="💙 法力值"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding PlayerManaCurrent}"
                                 Maximum="{Binding PlayerManaMax}"
                                 Height="10"
                                 Foreground="#2196F3"/>
                    <TextBlock FontSize="10"
                               Foreground="#666">
                        <Run Text="{Binding PlayerManaCurrent}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding PlayerManaMax}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 目标生命值 -->
                <StackPanel Grid.Column="2" Spacing="3" Margin="5,0,0,0">
                    <TextBlock Text="🎯 目标"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <ProgressBar Value="{Binding TargetHealthCurrent}"
                                 Maximum="{Binding TargetHealthMax}"
                                 Height="10"
                                 Foreground="#FF9800"/>
                    <TextBlock FontSize="10"
                               Foreground="#666">
                        <Run Text="{Binding TargetHealthCurrent}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TargetHealthMax}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- 调试信息 -->
            <Border Background="#F5F5F5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="15">
                <StackPanel Spacing="5">
                    <TextBlock Text="📊 调试信息"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock FontSize="11"
                               Foreground="#666"
                               FontFamily="Consolas,Menlo,monospace">
                        <Run Text="GlobalTime: "/>
                        <Run Text="{Binding GlobalTime}"/>
                        <Run Text="  |  Frames: "/>
                        <Run Text="{Binding WelcomeMessage}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
