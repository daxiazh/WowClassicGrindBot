<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VizAura.ViewModels"
             xmlns:models="using:VizAura.Models"
             x:Class="VizAura.Views.WowProcessStepView"
             x:DataType="vm:WowProcessStepViewModel">

    <StackPanel Spacing="10">
        <!-- 检查中/失败时持续显示 -->
        <TextBlock IsVisible="{Binding !ShowSuccessView}"
                   Text="⏳ 正在检查 WoW 进程..."
                   FontSize="12"
                   Foreground="#1976D2"
                   FontWeight="Medium"/>

        <!-- 成功视图 -->
        <StackPanel IsVisible="{Binding ShowSuccessView}" 
                    Spacing="5">
            <TextBlock Text="{Binding SuccessMessage}" 
                       Foreground="Green"
                       FontSize="12"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding WowPath}" 
                       FontSize="10" 
                       Foreground="Gray"/>
            <TextBlock Text="{Binding WindowId, StringFormat='窗口ID: {0}'}" 
                       FontSize="10"
                       Foreground="Gray"/>
        </StackPanel>
    </StackPanel>
</UserControl>
