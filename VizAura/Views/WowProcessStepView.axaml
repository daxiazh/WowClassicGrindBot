<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VizAura.ViewModels"
             xmlns:models="using:VizAura.Models"
             x:Class="VizAura.Views.WowProcessStepView"
             x:DataType="vm:WowProcessStepViewModel">

    <Border Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}"
            BorderBrush="{Binding Status, Converter={StaticResource StatusBorderBrushConverter}}"
            BorderThickness="4,0,0,0"
            CornerRadius="8" 
            Padding="15" 
            Margin="0,0,0,10"
            MinHeight="100">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
            </Transitions>
        </Border.Transitions>
        <StackPanel Spacing="10">
            <!-- 步骤标题 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="{Binding Status, Converter={StaticResource StatusIconConverter}}"
                           FontSize="20"
                           Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="1"
                           Text="{Binding StepName}" 
                           FontWeight="SemiBold"
                           FontSize="14"/>
            </Grid>

            <!-- 检查中/失败时持续显示 -->
            <TextBlock IsVisible="{Binding !ShowSuccessView}"
                       Text="⏳ 正在检查 WoW 进程..."
                       FontSize="12"
                       Foreground="#1976D2"
                       FontWeight="Medium"/>

            <!-- 成功视图 -->
            <StackPanel IsVisible="{Binding ShowSuccessView}" 
                        Spacing="5">
                <TextBlock Text="{Binding SuccessMessage}" 
                           Foreground="Green"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding WowPath}" 
                           FontSize="10" 
                           Foreground="Gray"/>
                <TextBlock Text="{Binding WindowId, StringFormat='窗口ID: {0}'}" 
                           FontSize="10"
                           Foreground="Gray"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
